# -------------------------------------------------------------------
# Frontend - GestPro (React + Vite)
# Copiez ce fichier vers `.env` (local) ou renseignez la variable dans
# Vercel (production).
# -------------------------------------------------------------------

# URL de l'API backend, sans slash final.
#
# Local    : http://localhost:3000/api
# Prod     : https://votre-service.onrender.com/api
#
# ⚠ Les variables VITE_* sont cuites AU BUILD : en les changeant dans
#   Vercel, il faut relancer un deploiement pour qu'elles prennent effet.
#
# ⚠ Il n'y a AUCUNE cle d'analyse ici. Le navigateur n'appelle jamais
#   l'API d'analyse directement : tout passe par /api/analytics/* du
#   backend, qui detient la cle cote serveur.
VITE_API_URL=http://localhost:3000/api
