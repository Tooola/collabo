# -------------------------------------------------------------------
# Backend - GestPro (Express + TypeScript)
# Copiez ce fichier vers `.env` (jamais versionne, voir backend/.gitignore)
# puis completez les valeurs.
# -------------------------------------------------------------------

# --- Serveur --------------------------------------------------------
# En production Render fournit PORT automatiquement.
PORT=3000

# URL du front, utilisee pour le CORS.
# Local : http://localhost:5173   Prod : https://votre-projet.vercel.app
# Sans cette variable en prod, le navigateur est bloque par CORS.
FRONTEND_URL=http://localhost:5173

# --- Securite --------------------------------------------------------
# ATTENTION : valeur de depot ci-dessous. A remplacer par une cle longue
# et aleatoire en production, sinon tous les JWT sont falsifiables.
JWT_SECRET=change_me_in_production

# --- Base de donnees (MongoDB Atlas) ---------------------------------
MONGO_URI=mongodb://localhost:27017/project-gest

# --- E-mails OTP (Brevo) - optionnel en local ------------------------
# Sans SMTP_USER/SMTP_PASSWORD, le code OTP est simule et ecrit dans le
# terminal du serveur. En production, renseigner les vraies valeurs.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@example.com

# --- Seed demo (idempotent, non destructif, zero deleteMany) ----------
# Se rejoue a chaque demarrage sans jamais ecraser l'existant.
#
# ⚠ PRODUCTION : le seed cree les comptes de demonstration
#   (admin@test.com, lead@test.com, dev@test.com) avec le mot de passe
#   SEED_PASSWORD. Passez SEED_ON_BOOT=false - ou changez SEED_PASSWORD -
#   des que les vrais comptes existent.
SEED_ON_BOOT=true
SEED_WORKSPACE_ID=
SEED_PASSWORD=password

# --- Analyse externe - STRICTEMENT COTE SERVEUR -----------------------
# Rien de tout ceci ne doit finir dans une variable VITE_*, dans le code,
# dans un journal ou dans git.
#
# La cle n'est affichee QU'UNE FOIS, a la creation de l'application.
# Si elle est perdue ou revoquee :
#   POST /api/v1/auth/login            -> JWT de dashboard
#   POST /api/v1/applications/me/regenerate-key
# L'ancienne cle est invalidee immediatement.
#
# 3 datasets a declarer cote API : flux-mensuel, taches, projets.
ANALYTICS_API_URL=https://analytics-6zid.onrender.com
ANALYTICS_API_KEY=
ANALYTICS_APP_SLUG=
